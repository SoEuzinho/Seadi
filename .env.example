# Banco de dados (compatível com MariaDB local, MySQL, ou Supabase)
# Para MariaDB/MySQL local: mysql://user:password@localhost:3306/dbname
# Para Supabase: postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=mysql://seadi:your_db_password@localhost:3306/seadi

# JWT (troque por uma chave grande e aleatória)
JWT_SECRET=replace_with_a_long_random_secret

# Gmail
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_app_password

NODE_ENV=production

# CORS: origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5000,https://seadi.sostudio.uk

# Backend URL (para Vercel/Cloudflare proxy)
BACKEND_URL=https://seadi-backend.onrender.com

# Supabase (opcional - para usar como banco de dados)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
